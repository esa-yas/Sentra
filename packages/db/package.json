{
  "name": "@sentra/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, seed, and client factory. PostgreSQL is the system of record.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "generate": "prisma generate",
    "migrate": "tsx scripts/with-root-env.ts prisma migrate dev",
    "deploy": "tsx scripts/with-root-env.ts prisma migrate deploy",
    "status": "tsx scripts/with-root-env.ts prisma migrate status",
    "reset": "tsx scripts/with-root-env.ts prisma migrate reset --force",
    "seed": "tsx scripts/with-root-env.ts tsx prisma/seed.ts",
    "studio": "tsx scripts/with-root-env.ts prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@sentra/config": "workspace:*",
    "prisma": "^6.7.0"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "ulid": "^3.0.0"
  }
}
