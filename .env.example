# Sentra environment template. Copy to .env and fill in locally.
# Never commit real values. Every variable below is validated at boot by @sentra/config.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3000
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------------------
# PostgreSQL — the system of record.
# DATABASE_URL is the pooled connection used at runtime (API + workers).
# DATABASE_DIRECT_URL bypasses the pooler and is required for Prisma migrations,
# because advisory locks and DDL do not work reliably through PgBouncer.
# Local development points both at the Docker Compose instance.
#
# On Supabase, take BOTH strings from Project Settings -> Database -> Connection string:
#   DATABASE_URL        -> "Transaction pooler"  (host ...pooler.supabase.com, port 6543)
#   DATABASE_DIRECT_URL -> "Direct connection"   (host db.<ref>.supabase.co,  port 5432)
# In production append sslmode=require to both (Supabase and Cloud SQL require TLS).
# The client factory auto-adds pgbouncer=true on port 6543; do not set it by hand.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://sentra:sentra@localhost:5432/sentra?schema=public
DATABASE_DIRECT_URL=postgresql://sentra:sentra@localhost:5432/sentra?schema=public
# Dedicated database for the integration suite (pnpm test:integration). Must be a local
# *_test database — the suite drops and recreates its schema on every run.
TEST_DATABASE_URL=postgresql://sentra:sentra@localhost:5432/sentra_test?schema=public

# ---------------------------------------------------------------------------
# Redis — queue transport and cache only. Never a source of business truth.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Supabase Auth — portal user identity.
# The service-role key belongs to the API and worker processes only.
# It must never be exposed to a browser or placed in a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Legacy symmetric verification. Leave blank to verify against the project JWKS instead.
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sentra-evidence

# ---------------------------------------------------------------------------
# Partner OAuth2 (client credentials). ES256 key pair in PKCS#8 / SPKI PEM,
# newlines escaped as \n. Generate with:
#   openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt
# ---------------------------------------------------------------------------
PARTNER_TOKEN_ISSUER=https://api.sentra.local
PARTNER_TOKEN_AUDIENCE=sentra-partner-api
PARTNER_TOKEN_ACTIVE_KID=dev-partner-key-1
PARTNER_TOKEN_PRIVATE_KEY_PEM=
PARTNER_TOKEN_PUBLIC_KEY_PEM=
PARTNER_TOKEN_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Decision path budgets. The synchronous lane must fail neutral, never hang.
# ---------------------------------------------------------------------------
DEFAULT_DEADLINE_MS=650
MAX_DEADLINE_MS=2000

# ---------------------------------------------------------------------------
# Rate limiting (per principal, sliding window).
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=600
RATE_LIMIT_TOKEN_MAX_REQUESTS=30
RATE_LIMIT_PARTNER_WRITE_MAX_REQUESTS=60
RATE_LIMIT_PARTNER_ORG_MAX_REQUESTS=300
RATE_LIMIT_PARTNER_ENDPOINT_MAX_REQUESTS=30

# ---------------------------------------------------------------------------
# Partner request signing (Slice 4A). Asymmetric ES256; partners keep the private key.
# ---------------------------------------------------------------------------
SIGNING_ALLOWED_ALGORITHMS=ES256
SIGNING_TIMESTAMP_SKEW_SECONDS=30
SIGNING_REPLAY_WINDOW_SECONDS=300

# Isolated development bootstrap for issuing SANDBOX partner credentials.
# Production refuses to boot if this is true. Slice 4B replaces it with human login.
PARTNER_BOOTSTRAP_ENABLED=false
PARTNER_BOOTSTRAP_TOKEN=

# ---------------------------------------------------------------------------
# Observability. Leave SENTRY_DSN blank to disable error reporting locally.
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Worker cadence.
# ---------------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=8
RETENTION_SWEEP_CRON="0 3 * * *"

# ---------------------------------------------------------------------------
# Next.js console. Only publishable values may be prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
